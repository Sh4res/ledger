{
	"version": "2.0.0",
	"type": "shell",
	"presentation": {
		"echo": false,
		"reveal": "always",
		"focus": false,
		"panel": "dedicated",
		"showReuseMessage": false,
		"clear": false,
		"close": true
	},
	"tasks": [
		{
			"label": "Backend",
			"type": "shell",
			"command": "[[ -n $CODER ]] && exec task terminal:backend || true",
			"icon": {
				"id": "terminal"
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"runOptions": {
				"instanceLimit": 1,
				"runOn": "folderOpen"
			},
			"isBackground": true,
			"hide": true,
			"problemMatcher": []
		}
	]
}
